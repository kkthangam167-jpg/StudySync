# ====================================================================
# StudySync Environment Configuration
# NOTE: Never commit your actual .env file or real secrets to GitHub!
# ====================================================================

# Environment Mode: 'development' (local) or 'production' (Vercel)
FLASK_ENV=development

# Application Secret Key
# Generate a strong 32-byte production key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-key-in-production

# AI Assistant Configuration (Google Gemini API)
# 1. Obtain a free API key from Google AI Studio: https://aistudio.google.com/
# 2. Paste your API key below (without quotes):
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Models: gemini-3.1-flash-lite (recommended fast model), gemini-3.8-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Database Configuration
# Local Development: Uses local SQLite file in instance/studysync.db
# DATABASE_URL=sqlite:///instance/studysync.db
#
# Production (Required on Vercel): Persistent PostgreSQL database
# Compatible with Supabase, Neon, AWS RDS, Render, etc.
# Format: postgresql://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///instance/studysync.db

